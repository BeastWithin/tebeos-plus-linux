+/* IE's IHTMLElementRender::DrawToDC renders an element's pixels into the given
+ * DC.  TEBEOS calls it on the SGK Medula captcha <img> and then OCRs the result,
+ * so the pixels must be the element's *current* already-decoded image.
+ *
+ * wine-gecko exposes no XML-visible way to read a decoded image's pixels (canvas
+ * is JS-only and Wine's DOM wrappers don't implement it, imgIContainer::getFrame
+ * returns an opaque moz2d SourceSurface, and a dynamically appended <script> runs
+ * asynchronously so it cannot fill the DC synchronously), and re-fetching the
+ * SayiUretenImageYeniServlet URL regenerates a different captcha.  So, like IE's
+ * own rendering, we force Gecko to synchronously paint its current content into
+ * the browser window (nsIDOMWindowUtils::Redraw) and then blit the element's
+ * exact viewport rectangle out of that surface - the same already-decoded image
+ * with no stale frame and no off-by-one coordinate error.
+ */
+
+static HRESULT WINAPI HTMLElementRender_DrawToDC(IHTMLElementRender *iface, void *hdc_arg)
+{
+    HTMLElement *This = impl_from_IHTMLElementRender(iface);
+    HTMLOuterWindow *outer;
+    nsIDOMWindowUtils *window_utils = NULL;
+    nsIDOMClientRect *rect = NULL;
+    UINT32 redrawn = 0;
+    HDC hdc = hdc_arg, srcdc;
+    HWND hwnd;
+    float left = 0, top = 0, width = 0, height = 0;
+    int x, y, w, h;
+    nsresult nsres;
+
+    TRACE("(%p)->(%p)\n", This, hdc_arg);
+
+    if(!hdc || !This->dom_element || !This->node.doc || !This->node.doc->window)
+        return E_FAIL;
+
+    outer = This->node.doc->window->base.outer_window;
+    if(!outer || !outer->nswindow)
+        return E_FAIL;
+
+    /* Force a synchronous paint so the window surface holds the element's current
+     * image rather than a stale/previous captcha frame. */
+    get_nsinterface((nsISupports*)outer->nswindow, &IID_nsIDOMWindowUtils, (void**)&window_utils);
+    if(window_utils) {
+        nsIDOMWindowUtils_Redraw(window_utils, 1, &redrawn);
+        nsIDOMWindowUtils_Release(window_utils);
+    }
+
+    nsres = nsIDOMElement_GetBoundingClientRect(This->dom_element, &rect);
+    if(NS_FAILED(nsres) || !rect)
+        return E_FAIL;
+
+    nsIDOMClientRect_GetLeft(rect, &left);
+    nsIDOMClientRect_GetTop(rect, &top);
+    nsIDOMClientRect_GetWidth(rect, &width);
+    nsIDOMClientRect_GetHeight(rect, &height);
+    nsIDOMClientRect_Release(rect);
+
+    x = (int)(left + 0.5f);
+    y = (int)(top + 0.5f);
+    w = (int)(width + 0.5f);
+    h = (int)(height + 0.5f);
+    if(w <= 0 || h <= 0)
+        return E_FAIL;
+
+    hwnd = outer->browser ? outer->browser->hwnd : NULL;
+    if(!hwnd || !IsWindow(hwnd))
+        return E_FAIL;
+
+    srcdc = GetDC(hwnd);
+    if(!srcdc)
+        return E_FAIL;
+
+    TRACE("blitting %dx%d from (%d,%d)\n", w, h, x, y);
+    BitBlt(hdc, 0, 0, w, h, srcdc, x, y, SRCCOPY);
+    ReleaseDC(hwnd, srcdc);
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLElementRender_SetDocumentPrinter(IHTMLElementRender *iface, BSTR printer, void *hdc)
+{
+    FIXME("(%p)->(%s %p): stub\n", impl_from_IHTMLElementRender(iface), debugstr_w(printer), hdc);
+    return E_NOTIMPL;
+}
