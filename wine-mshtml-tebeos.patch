+    object,
+    local,
+    uuid(3050f669-98b5-11cf-bb82-00aa00bdce0b)
+]
+interface IHTMLElementRender : IUnknown
+{
+    HRESULT DrawToDC([in] void *hdc);
+    HRESULT SetDocumentPrinter([in] BSTR bstrPrinterName, [in] void *hdc);
+}
